# Fireworks AI Standard-Passwort für neue Accounts
FIREWORKS_PASSWORD=ZOE.jerry2024

# Anzahl Accounts pro Lauf
ACCOUNTS_PER_RUN=1

# Wartezeiten (ms) — Human-like Delays
